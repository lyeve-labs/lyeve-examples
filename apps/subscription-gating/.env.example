LYEVE_API_URL=http://localhost:4402
LYEVE_ADMIN_URL=http://localhost:4401
LYEVE_EMAIL=admin@lyeve.example
LYEVE_PASSWORD=Admin12345678

# Signs the cookie that names the reader, and verifies the inbound subscription
# webhook. Both are development values. A real deployment takes the webhook
# secret from the payment provider's dashboard and never commits either.
SUBSCRIPTION_COOKIE_SECRET=subscription-gating-dev-cookie-secret
SUBSCRIPTION_WEBHOOK_SECRET=subscription-gating-dev-webhook-secret
