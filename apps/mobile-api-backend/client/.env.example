# setup/provision.ts writes the real values into client/.env, which is
# gitignored. These are the names it uses.
#
# The engine stores a peppered HMAC of a key and returns the plaintext once, in
# the create response, so a lost key is minted again rather than recovered.
LYEVE_MOBILE_API_KEY=ly_replace_me
LYEVE_MOBILE_PROBE_KEY=ly_replace_me
