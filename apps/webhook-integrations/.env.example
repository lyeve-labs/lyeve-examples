LYEVE_API_URL=http://localhost:4402
LYEVE_ADMIN_URL=http://localhost:4401
LYEVE_EMAIL=admin@lyeve.example
LYEVE_PASSWORD=Admin12345678

# The signing key this app's receiver verifies with, and the one it registers
# on the engine. The outbound webhook validator refuses a secret shorter than
# sixteen characters. Development values: a real deployment mints a random
# secret, keeps it in a secret manager, and gives the receiver and the engine
# the same value.
HOOKS_RECEIVER_SECRET=webhook-integrations-dev-receiver-secret

# The signing key for the inbound endpoint, which is the reverse direction: a
# vendor signs with it and the engine verifies. Set once when the incoming
# webhook is created. The engine never hands it back.
HOOKS_INBOUND_SECRET=webhook-integrations-dev-inbound-secret

# Where the engine should deliver. Left empty, the dashboard registers the
# origin the browser is currently using, which is what you want locally.
HOOKS_RECEIVER_URL=
