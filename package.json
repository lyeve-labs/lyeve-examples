{
  "name": "lyeve-examples",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node platform/scripts/check-kit-range.mjs && pnpm -r --if-present check",
    "build": "pnpm -r --if-present build",
    "preinstall": "node -e \"if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('Use pnpm: this repository installs with pnpm only.');process.exit(1)}\""
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@lyeve-labs/client": "^0.3.3",
    "@lyeve-labs/client-rest": "^0.2.0"
  }
}
